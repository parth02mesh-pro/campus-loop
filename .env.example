# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Auth
AUTH_SECRET=your-256-bit-secret-change-in-production

# Email (optional)
EMAIL_API_KEY=
EMAIL_FROM=noreply@campusloop.in

# SMS / OTP (optional)
SMS_API_KEY=

# Payment Gateway - Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Object Storage (optional - for product images)
STORAGE_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Campus Loop
